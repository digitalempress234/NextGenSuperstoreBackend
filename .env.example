APP_NAME=Purse
NODE_ENV=
PORT=
BASE_URL=
API_PREFIX=purse

DATABASE_URL=
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# Passkeys/WebAuthn. RP ID is the domain only; origins are comma-separated HTTPS origins.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=


JWT_STAFF_SECRET=
FRONTEND_URL=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
PAYMENT_APP_RETURN_URL=


REFERRAL_REWARD_DESCRIPTION=
# 32 random bytes encoded as 64 hex characters. Keep stable and back it up securely.
# Required for encrypting BNPL documents and bank account numbers.
BNPL_DATA_KEY=

# Klump BNPL. Use test keys with KLUMP_MODE=test and live keys with KLUMP_MODE=live.
KLUMP_PUBLIC_KEY=
KLUMP_SECRET_KEY=
KLUMP_MODE=test
KLUMP_BASE_URL=https://api.useklump.com
# Optional client/app return URL supplied to the Klump checkout widget.
KLUMP_REDIRECT_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

CORS_ORIGIN=

# General API traffic is tracked per authenticated user, or by client IP for
# public requests. Authentication endpoints retain a stricter controller limit.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
LOG_LEVEL=

# Firebase service-account JSON on one line. Leave empty to disable background push.
FIREBASE_SERVICE_ACCOUNT_JSON=


PRISMA_DB_PUSH=


SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=


AUTH_COOKIE_SECURE=

AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_ACCESS_COOKIE_NAME=
AUTH_REFRESH_COOKIE_NAME=


OTP_PEPPER=
OTP_TTL_MINUTES=
OTP_COOLDOWN_SECONDS=
OTP_MAX_ATTEMPTS=


# OAuth 2.0 Web application client ID. Use this same value as the Android
# Google Sign-In `serverClientId`; the backend validates the ID-token audience against it.
GOOGLE_CLIENT_ID=
# Register the Android app and signing fingerprints in Google Cloud/Firebase.
# These are documentation/deployment values and are not used as backend secrets.
GOOGLE_ANDROID_PACKAGE_NAME=com.example.superstore_driver
GOOGLE_ANDROID_DEBUG_SHA1=FB:81:5B:39:44:42:B7:63:3D:D1:E0:85:49:33:DF:E4:C3:17:B7:61
GOOGLE_ANDROID_DEBUG_SHA256=4E:E6:7E:0E:52:1D:CF:73:B1:C6:22:71:C3:88:40:E2:5F:FF:81:9D:96:5B:9D:31:EA:FA:3D:70:F3:67:EC:B9


RUN_PRISMA_MIGRATIONS_ON_START=
APP_PORT=


DELIVERY_LOCATION_MIN_INTERVAL_MS=
DELIVERY_LOCATION_RETENTION_DAYS=

# Rider job-board GPS matching. Defaults: 10 km, 120 seconds, 500 metres accuracy.
RIDER_JOB_RADIUS_KM=10
RIDER_LOCATION_MAX_AGE_SECONDS=120
RIDER_LOCATION_MAX_ACCURACY_M=500

# Socket.IO is publicly served at /socket.io and uses the /delivery namespace.
# Keep the reverse proxy route aligned with these fixed client-facing values.

PRISMA_QUERY_LOGS=

LOG_OTP_CODES=

IDENTRO_API_KEY=
IDENTRO_BASE_URL=https://api.identro.ng
IDENTRO_API_KEY_HEADER=
IDENTRO_AUTO_APPROVE_ON_MATCH=

QOREID_CLIENT_ID=
QOREID_CLIENT_SECRET=
QOREID_BASE_URL=
QOREID_AUTO_APPROVE_ON_MATCH=

VAT_RATE=
SERVICE_CHARGE_RATE=
PLATFORM_FEE_RATE=
# Maximum JSON request size. Identro passive liveness sends a base64 selfie.
HTTP_JSON_BODY_LIMIT=8mb
