{
  "name": "purse-superstore-api",
  "version": "9.0.0",
  "private": true,
  "description": "Production-oriented NestJS backend for the Purse Superstore marketplace",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,prisma,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,prisma,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,prisma,test}/**/*.{ts,md,json,yml}\"",
    "format:check": "prettier --check \"{src,prisma,test}/**/*.{ts,md,json,yml}\"",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "check": "npm run prisma:validate && npm run format:check && npm run lint && npm run build && npm test",
    "docker:build": "docker build -t purse-superstore-api:local .",
    "docker:run": "docker compose up -d"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "@scalar/nestjs-api-reference": "^1.2.16",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.10.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^10.4.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "libphonenumber-js": "^1.12.25",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^9.0.5",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/compression": "^1.8.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.5",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  }
}
