# Put this map in Nginx's `http` context (outside the server block).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Put this location in the HTTPS server block for api.syroltech.com.
# Port 8084 matches APP_PORT's production default in docker-compose.production.yml.
location /socket.io/ {
    proxy_pass http://127.0.0.1:8084;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_buffering off;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
}

# After deployment, this polling probe must return HTTP 200 and an Engine.IO
# opening packet (starting with `0{`), rather than Express's HTTP 404 response:
# curl -i 'https://api.syroltech.com/socket.io/?EIO=4&transport=polling'
